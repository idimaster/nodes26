    "Finding": [
      {
        "deal_code": "nimbus",
        "id": "f-gen-01",
        "kind": "assumption",
        "text": "Nimbus customers are assumed to accept a login-page change with one month of notice.",
        "severity": "medium",
        "confidence": 0.91,
        "evidence_type": "vendor_docs"
      },
      {
        "deal_code": "nimbus",
        "id": "f-gen-02",
        "kind": "risk",
        "text": "The primary database runs a major version that leaves vendor support next year.",
        "severity": "low",
        "confidence": 0.51,
        "evidence_type": "rfi"
      },
      {
        "deal_code": "nimbus",
        "id": "f-gen-03",
        "kind": "gap",
        "text": "Customer webhooks are delivered without retries or payload signing.",
        "severity": "high",
        "confidence": 0.92,
        "evidence_type": "vendor_docs"
      },
      {
        "deal_code": "nimbus",
        "id": "f-gen-04",
        "kind": "risk",
        "text": "An invoice-capture OCR component is licensed per server, not per tenant.",
        "severity": "high",
        "confidence": 0.55,
        "evidence_type": "assumption"
      },
      {
        "deal_code": "nimbus",
        "id": "f-gen-05",
        "kind": "capability",
        "text": "Nimbus maintains a small reporting warehouse fed by nightly batch jobs.",
        "severity": "medium",
        "confidence": 0.56,
        "evidence_type": "vendor_docs"
      },
      {
        "deal_code": "nimbus",
        "id": "f-gen-06",
        "kind": "assumption",
        "text": "Customer churn is assumed to stay flat through the integration.",
        "severity": "high",
        "confidence": 0.57,
        "evidence_type": "interview"
      },
      {
        "deal_code": "nimbus",
        "id": "f-gen-07",
        "kind": "capability",
        "text": "Nimbus runs its own API gateway in front of public endpoints, with per-tenant rate limits.",
        "severity": "low",
        "confidence": 0.42,
        "evidence_type": "assumption"
      },
      {
        "deal_code": "nimbus",
        "id": "f-gen-08",
        "kind": "risk",
        "text": "Two senior engineers hold most of the knowledge of the ledger reconciliation code.",
        "severity": "high",
        "confidence": 0.81,
        "evidence_type": "vendor_docs"
      },
      {
        "deal_code": "nimbus",
        "id": "f-gen-09",
        "kind": "assumption",
        "text": "Finance assumes Nimbus revenue-recognition rules already match Harborline's.",
        "severity": "high",
        "confidence": 0.77,
        "evidence_type": "vendor_docs"
      },
      {
        "deal_code": "nimbus",
        "id": "f-gen-10",
        "kind": "gap",
        "text": "Production infrastructure is defined partly in scripts and partly by hand; configuration drift is common.",
        "severity": "medium",
        "confidence": 0.42,
        "evidence_type": "interview"
      },
      {
        "deal_code": "nimbus",
        "id": "f-gen-11",
        "kind": "capability",
        "text": "Nimbus keeps secrets for its newest services in a self-hosted vault.",
        "severity": "low",
        "confidence": 0.93,
        "evidence_type": "assumption"
      }
    ]
  },
