{
  "name": "neurosymbolic-planner-neo4j",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "vitest run",
    "test:ui": "playwright test",
    "coverage": "vitest run --coverage packages/engine tests/engine",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p viz/tsconfig.json",
    "lint": "eslint .",
    "denylist": "tsx scripts/denylist-check.ts",
    "check:tools": "tsx scripts/check-tool-surface.ts",
    "skill:sync": "tsx scripts/sync-skill.ts",
    "schema:gen": "tsx scripts/gen-schema.ts",
    "schema": "tsx graph/apply-schema.ts",
    "generate": "tsx scripts/generate-data.ts",
    "load": "tsx graph/load/index.ts",
    "validate": "tsx graph/validate.ts",
    "coverage:edges": "tsx scripts/edge-coverage.ts",
    "mcp:engine": "tsx packages/engine-mcp/src/server.ts",
    "mcp:gate": "tsx packages/gate/bin/gate-mcp.ts",
    "mcp:graph": "tsx packages/graph-mcp/bin/graph-mcp.ts",
    "mcp:ontology": "tsx packages/ontology-mcp/bin/ontology-mcp.ts",
    "ui:build": "tsx scripts/build-ui.ts",
    "browser:gen": "tsx scripts/gen-browser.ts",
    "demo:ui": "tsx scripts/build-ui.ts && tsx packages/gate/bin/console.ts",
    "console": "npm run demo:ui",
    "demo:replay": "tsx scripts/replay.ts",
    "record:session": "tsx scripts/record-session.ts",
    "record:golden": "RECORD_REPLAY=data/replays/nimbus-v1.jsonl vitest run tests/e2e/nimbus-skill-walk.test.ts && RECORD_REPLAY=data/replays/nimbus-p4.jsonl vitest run tests/e2e/p4-feedback.test.ts",
    "mcp:neo4j:install": "scripts/install-neo4j-mcp.sh",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "cytoscape": "3.34.3",
    "cytoscape-dagre": "4.0.1",
    "cytoscape-fcose": "2.2.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "neo4j-driver": "6.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
