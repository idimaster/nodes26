{
  "name": "neurosymbolic-planner-neo4j",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage packages/engine tests/engine",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "denylist": "tsx scripts/denylist-check.ts",
    "check:tools": "tsx scripts/check-tool-surface.ts",
    "skill:sync": "tsx scripts/sync-skill.ts",
    "schema:gen": "tsx scripts/gen-schema.ts",
    "schema": "tsx graph/apply-schema.ts",
    "generate": "tsx scripts/generate-data.ts",
    "load": "tsx graph/load/index.ts",
    "validate": "tsx graph/validate.ts",
    "mcp:engine": "tsx packages/engine-mcp/src/server.ts",
    "mcp:gate": "tsx packages/gate/bin/gate-mcp.ts",
    "console": "tsx packages/gate/bin/console.ts",
    "mcp:neo4j:install": "scripts/install-neo4j-mcp.sh",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "neo4j-driver": "6.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
