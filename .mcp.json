{
  "mcpServers": {
    "neo4j-read": {
      "command": "scripts/neo4j-mcp.sh",
      "args": [
        "--read-only",
        "true"
      ]
    },
    "neo4j-write": {
      "command": "scripts/neo4j-mcp.sh",
      "args": [
        "--read-only",
        "false"
      ]
    },
    "planner-engine": {
      "command": "node_modules/.bin/tsx",
      "args": [
        "packages/engine-mcp/src/server.ts"
      ]
    },
    "gate": {
      "command": "node_modules/.bin/tsx",
      "args": [
        "packages/gate/bin/gate-mcp.ts"
      ]
    },
    "planner-graph": {
      "command": "node_modules/.bin/tsx",
      "args": [
        "packages/graph-mcp/bin/graph-mcp.ts"
      ]
    },
    "ontology": {
      "command": "node_modules/.bin/tsx",
      "args": [
        "packages/ontology-mcp/bin/ontology-mcp.ts"
      ]
    }
  }
}
