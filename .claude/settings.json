{
  "env": {
    "MCP_TOOL_TIMEOUT": "60000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__neo4j-write__write-cypher",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/node_modules/.bin/tsx\" \"$CLAUDE_PROJECT_DIR/packages/guard/bin/guard-hook.ts\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
